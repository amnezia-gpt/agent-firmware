{
 "description": "Test vectors for the workload release manifest, schema 4. 'valid' is accepted. Each rejection applies one change to 'valid' (set: JSON Pointer to new value; remove: JSON Pointer) and must be refused before any change on the host. layer says whether the JSON Schema alone refuses it or a semantic rule of SELF-21 DESIGN.md. Names are examples; the firmware knows none of them.",
 "valid": {
  "schema_version": 4,
  "kind": "workload-release",
  "release": "v1.2.3",
  "source_revision": "0123456789abcdef0123456789abcdef01234567",
  "device_api": "urn:agent-firmware:device-api:v3",
  "platforms": [
   "linux/amd64",
   "linux/arm64"
  ],
  "volumes": {
   "front-state": {
    "retention": "enrollment"
   },
   "worker-home": {
    "retention": "user-data"
   },
   "worker-auth": {
    "retention": "enrollment"
   }
  },
  "services": {
   "front": {
    "image": {
     "repository": "registry.example/acme/front",
     "digest": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    },
    "user": "65532:65532",
    "aliases": [
     "front"
    ],
    "environment": {
     "AUTH_ISSUER": {
      "from": "issuer"
     },
     "TRUST_BUNDLE": {
      "from": "trust_bundle"
     },
     "TRUST_SHA256": {
      "from": "trust_bundle_sha256"
     },
     "API_BASE_URL": {
      "from": "resource",
      "scope": "example:use"
     },
     "STATE_DIR": {
      "value": "/var/lib/front"
     }
    },
    "volumes": [
     {
      "source": "front-state",
      "target": "/var/lib/front"
     },
     {
      "source": "worker-auth",
      "target": "/run/worker-auth"
     }
    ],
    "health_start_seconds": 5,
    "stop_grace_seconds": 15
   },
   "worker": {
    "image": {
     "repository": "registry.example/acme/worker",
     "digest": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
    },
    "read_only": true,
    "aliases": [
     "worker"
    ],
    "depends_on": [
     "front"
    ],
    "volumes": [
     {
      "source": "worker-home",
      "target": "/home/worker"
     },
     {
      "source": "worker-auth",
      "target": "/run/worker-auth",
      "read_only": true
     }
    ],
    "health_start_seconds": 60,
    "stop_grace_seconds": 20
   }
  },
  "device_api_client": {
   "service": "front",
   "dial": [
    "frontctl",
    "dial-stdio"
   ],
   "enrollment_status": [
    "frontctl",
    "enrollment",
    "status"
   ],
   "deregister": [
    "frontctl",
    "deregister"
   ]
  }
 },
 "reject": [
  {
   "reason": "unknown top-level member",
   "layer": "schema",
   "set": {
    "/ports": [
     "443:443"
    ]
   }
  },
  {
   "reason": "unknown service member (published port)",
   "layer": "schema",
   "set": {
    "/services/front/ports": [
     "443:443"
    ]
   }
  },
  {
   "reason": "unknown service member (privileged)",
   "layer": "schema",
   "set": {
    "/services/front/privileged": true
   }
  },
  {
   "reason": "image by tag instead of digest",
   "layer": "schema",
   "set": {
    "/services/front/image": {
     "repository": "registry.example/acme/front",
     "tag": "latest"
    }
   }
  },
  {
   "reason": "repository carries a tag",
   "layer": "schema",
   "set": {
    "/services/front/image/repository": "registry.example/acme/front:latest"
   }
  },
  {
   "reason": "root user",
   "layer": "schema",
   "set": {
    "/services/front/user": "0:0"
   }
  },
  {
   "reason": "named user instead of numeric",
   "layer": "schema",
   "set": {
    "/services/front/user": "root"
   }
  },
  {
   "reason": "host path as a volume source",
   "layer": "schema",
   "set": {
    "/services/front/volumes/0/source": "/var/run/docker.sock"
   }
  },
  {
   "reason": "relative mount target",
   "layer": "schema",
   "set": {
    "/services/front/volumes/0/target": "var/lib/front"
   }
  },
  {
   "reason": "mount target with a parent reference",
   "layer": "semantic",
   "set": {
    "/services/front/volumes/0/target": "/var/../etc"
   }
  },
  {
   "reason": "free-form template in an environment value source",
   "layer": "schema",
   "set": {
    "/services/front/environment/AUTH_ISSUER": {
     "from": "env:HOME"
    }
   }
  },
  {
   "reason": "environment value given as a bare string",
   "layer": "schema",
   "set": {
    "/services/front/environment/STATE_DIR": "/var/lib/front"
   }
  },
  {
   "reason": "resource source without a scope",
   "layer": "schema",
   "set": {
    "/services/front/environment/API_BASE_URL": {
     "from": "resource"
    }
   }
  },
  {
   "reason": "unsupported platform",
   "layer": "schema",
   "set": {
    "/platforms": [
     "windows/amd64"
    ]
   }
  },
  {
   "reason": "unsupported device API version",
   "layer": "schema",
   "set": {
    "/device_api": "urn:agent-firmware:device-api:v2"
   }
  },
  {
   "reason": "earlier schema version",
   "layer": "schema",
   "set": {
    "/schema_version": 3
   }
  },
  {
   "reason": "no device API client",
   "layer": "schema",
   "remove": "/device_api_client"
  },
  {
   "reason": "control command through a shell string",
   "layer": "schema",
   "set": {
    "/device_api_client/dial": "frontctl dial-stdio"
   }
  },
  {
   "reason": "volume used but not declared",
   "layer": "semantic",
   "set": {
    "/services/worker/volumes/0/source": "undeclared"
   }
  },
  {
   "reason": "volume declared but never used",
   "layer": "semantic",
   "set": {
    "/volumes/spare": {
     "retention": "enrollment"
    }
   }
  },
  {
   "reason": "dependency on an unknown service",
   "layer": "semantic",
   "set": {
    "/services/worker/depends_on": [
     "missing"
    ]
   }
  },
  {
   "reason": "dependency cycle",
   "layer": "semantic",
   "set": {
    "/services/front/depends_on": [
     "worker"
    ]
   }
  },
  {
   "reason": "service depends on itself",
   "layer": "semantic",
   "set": {
    "/services/worker/depends_on": [
     "worker"
    ]
   }
  },
  {
   "reason": "device API client names an unknown service",
   "layer": "semantic",
   "set": {
    "/device_api_client/service": "missing"
   }
  },
  {
   "reason": "same alias on two services",
   "layer": "semantic",
   "set": {
    "/services/worker/aliases": [
     "front"
    ]
   }
  },
  {
   "reason": "alias equal to another service's name",
   "layer": "semantic",
   "set": {
    "/services/front/aliases": [
     "worker"
    ]
   }
  },
  {
   "reason": "two volumes at one target in a service",
   "layer": "semantic",
   "set": {
    "/services/front/volumes/1/target": "/var/lib/front"
   }
  },
  {
   "reason": "one volume mounted twice in a service",
   "layer": "semantic",
   "set": {
    "/services/front/volumes/1/source": "front-state"
   }
  },
  {
   "reason": "mount target inside another mount target",
   "layer": "semantic",
   "set": {
    "/services/front/volumes/1/target": "/var/lib/front/auth"
   }
  },
  {
   "reason": "mount target that the firmware reserves",
   "layer": "semantic",
   "set": {
    "/services/front/volumes/1/target": "/tmp"
   }
  },
  {
   "reason": "volumes as a list of names (schema 3 shape)",
   "layer": "schema",
   "set": {
    "/volumes": [
     "front-state",
     "worker-home",
     "worker-auth"
    ]
   }
  },
  {
   "reason": "volume without a retention class",
   "layer": "schema",
   "set": {
    "/volumes/worker-home": {}
   }
  },
  {
   "reason": "unknown retention class",
   "layer": "schema",
   "set": {
    "/volumes/worker-home/retention": "keep"
   }
  },
  {
   "reason": "retention given as a boolean",
   "layer": "schema",
   "set": {
    "/volumes/worker-home/retention": true
   }
  },
  {
   "reason": "unknown volume member (host path)",
   "layer": "schema",
   "set": {
    "/volumes/worker-home/path": "/srv/data"
   }
  },
  {
   "reason": "unknown volume member (driver)",
   "layer": "schema",
   "set": {
    "/volumes/worker-home/driver": "nfs"
   }
  },
  {
   "reason": "volume name outside the pattern",
   "layer": "schema",
   "set": {
    "/volumes/Worker_Home": {
     "retention": "user-data"
    }
   }
  }
 ],
 "control_results": {
  "accept": [
   {
    "state": "enrolled"
   },
   {
    "state": "pending",
    "reason": "redeeming"
   },
   {
    "state": "failed",
    "reason": "code_refused"
   },
   {
    "state": "deregistered"
   }
  ],
  "treat_as_unavailable": [
   "",
   "not json",
   {
    "state": "ready"
   },
   {
    "state": "enrolled",
    "detail": "x"
   },
   {
    "state": "failed",
    "reason": "Has Spaces"
   }
  ]
 },
 "held_volumes": {
  "description": "Checks against volumes the host already holds for the manifest's domain. 'held' maps a volume name to the class in its label; null is a firmware volume without a class label. 'volumes' replaces the valid manifest's volumes (services are adjusted to mount exactly these). A refusal happens before any change on the host.",
  "accept": [
   {
    "reason": "first enrollment, nothing held",
    "held": {}
   },
   {
    "reason": "same volumes, same classes",
    "held": {
     "front-state": "enrollment",
     "worker-home": "user-data",
     "worker-auth": "enrollment"
    }
   },
   {
    "reason": "kept user data attached by a new enrollment",
    "held": {
     "worker-home": "user-data"
    }
   },
   {
    "reason": "release adds a user data volume",
    "held": {
     "front-state": "enrollment",
     "worker-home": "user-data",
     "worker-auth": "enrollment"
    },
    "volumes": {
     "front-state": {
      "retention": "enrollment"
     },
     "worker-home": {
      "retention": "user-data"
     },
     "worker-auth": {
      "retention": "enrollment"
     },
     "worker-files": {
      "retention": "user-data"
     }
    }
   },
   {
    "reason": "release drops an enrollment volume",
    "operation": "update",
    "held": {
     "front-state": "enrollment",
     "worker-home": "user-data",
     "worker-auth": "enrollment"
    },
    "volumes": {
     "front-state": {
      "retention": "enrollment"
     },
     "worker-home": {
      "retention": "user-data"
     }
    }
   }
  ],
  "refuse": [
   {
    "reason": "release drops a user data volume",
    "held": {
     "front-state": "enrollment",
     "worker-home": "user-data",
     "worker-auth": "enrollment"
    },
    "volumes": {
     "front-state": {
      "retention": "enrollment"
     },
     "worker-auth": {
      "retention": "enrollment"
     }
    }
   },
   {
    "reason": "release renames a user data volume",
    "held": {
     "front-state": "enrollment",
     "worker-home": "user-data",
     "worker-auth": "enrollment"
    },
    "volumes": {
     "front-state": {
      "retention": "enrollment"
     },
     "worker-data": {
      "retention": "user-data"
     },
     "worker-auth": {
      "retention": "enrollment"
     }
    }
   },
   {
    "reason": "release turns user data into an enrollment volume",
    "held": {
     "front-state": "enrollment",
     "worker-home": "user-data",
     "worker-auth": "enrollment"
    },
    "volumes": {
     "front-state": {
      "retention": "enrollment"
     },
     "worker-home": {
      "retention": "enrollment"
     },
     "worker-auth": {
      "retention": "enrollment"
     }
    }
   },
   {
    "reason": "release turns an enrollment volume into user data",
    "held": {
     "front-state": "enrollment",
     "worker-home": "user-data",
     "worker-auth": "enrollment"
    },
    "volumes": {
     "front-state": {
      "retention": "user-data"
     },
     "worker-home": {
      "retention": "user-data"
     },
     "worker-auth": {
      "retention": "enrollment"
     }
    }
   },
   {
    "reason": "held volume without a class label",
    "held": {
     "worker-home": null
    }
   }
  ]
 }
}
