{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-firmware:workload-control:enrollment-status:v1",
  "title": "Workload enrollment status result",
  "type": "object",
  "additionalProperties": false,
  "required": ["state"],
  "properties": {
    "state": {
      "enum": ["enrolled", "pending", "failed", "unenrolled"]
    },
    "reason": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    }
  }
}
